# Copy this file to ".env" and fill in your key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides — any current Claude model string works.
JUDGE_MODEL=claude-opus-5
COUNSEL_MODEL=claude-sonnet-5
RESEARCH_MODEL=claude-sonnet-5
JURY_MODEL=claude-sonnet-5

# Caps repetitions for the "run N times, compare outcomes" batch endpoint.
MAX_BATCH_RUNS=5
